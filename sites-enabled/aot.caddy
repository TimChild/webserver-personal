# Variables are: DOMAIN, SITE_NAME, BACKEND_SERVICE
http://adventuresoftim.com http://www.adventuresoftim.com www.adventuresoftim.com {
	redir https://adventuresoftim.com{uri}
}

adventuresoftim.com {
	encode gzip
	# Enable access logging
	log {
		output file /var/log/caddy/access.log {
			mode 644
			roll_size 10MiB
			roll_keep 5
		}
		format console
	}

	# Enable error logging
	handle_errors {
		respond "{err.status_code} {err.status_text}: {err.message}"
	}


	# --- Preview of the next site version (TimChild/adventuresoftim, deploy target=preview) ---
	# Visit /_preview/on to opt in (sets a cookie), /_preview/off to opt out. Files that exist in
	# /srv/www/aot-preview are served from there for opted-in browsers; everything else falls through.
	handle /_preview/on {
		header Set-Cookie "aot_preview=1; Path=/; Max-Age=604800; Secure; SameSite=Lax"
		header Cache-Control "no-store"
		redir * / 302
	}
	handle /_preview/off {
		header Set-Cookie "aot_preview=; Path=/; Max-Age=0; Secure; SameSite=Lax"
		header Cache-Control "no-store"
		redir * / 302
	}
	@preview {
		header Cookie *aot_preview=1*
		file {
			root /srv/www/aot-preview
			try_files {path} {path}/
		}
	}
	handle @preview {
		header Cache-Control "no-store"
		root * /srv/www/aot-preview
		try_files {path} {path}/
		file_server
	}

	@backend_routes path /_event/* /ping /_upload /_upload/*
	handle @backend_routes {
		reverse_proxy aot-backend:8000
	}

	# File matcher to check if the request points to a valid quarto file
	# NOTE: Do not catch {path}/ here as it captures the root path that should be 
	# handled by aot nextjs -- instead check {path}/ in the catch-all handle block
	@isInQuarto file {
		root /srv/www/aot-quarto
		try_files {path} {path}.html
	}
	handle @isInQuarto {
		root * /srv/www/aot-quarto
		try_files {path} {path}.html
		file_server
	}

	# File matcher to check if the request points to a valid aot nextjs file
	@isInAot file {
		root /srv/www/aot
		try_files {path} {path}/
	}
	handle @isInAot {
		root * /srv/www/aot
		try_files {path} {path}/
		file_server
	}

	# Quarto directories (e.g. /guides/adding-a-post/) -- checked here rather than in
	# @isInQuarto because {path}/ would capture the root path that belongs to the main site
	@isQuartoDir file {
		root /srv/www/aot-quarto
		try_files {path}/
	}
	handle @isQuartoDir {
		root * /srv/www/aot-quarto
		try_files {path}/
		file_server
	}

	# Anything that didn't match -- serve the quarto 404 page, with a real 404 status
	# (a 200 here let Cloudflare cache the 404 page under asset URLs like /og.png)
	handle {
		root * /srv/www/aot-quarto
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}

